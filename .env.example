# Salin ke .env di root proyek dan isi API key sendiri.
NUSAKLIM_WEATHER_API_KEY=change-me
NUSAKLIM_HOST=127.0.0.1
NUSAKLIM_PORT=8000
NUSAKLIM_RELOAD=true

NUSAKLIM_APP_NAME="NusaKlim Weather AI REST API"
NUSAKLIM_APP_VERSION=1.0.0
# NUSAKLIM_APP_DESCRIPTION="Deskripsi API sendiri"
NUSAKLIM_API_PREFIX=/api/v1
NUSAKLIM_CORS_ORIGINS='["*"]'
NUSAKLIM_MAX_BULK_STATIONS=50
NUSAKLIM_MAX_INGEST_RECORDS=100000

# Root proyek bisa diatur di sini; default mengikuti lokasi checkout.
NUSAKLIM_PROJECT_ROOT=.
# base_dir mengikuti project_root; override ini opsional.
# NUSAKLIM_BASE_DIR=/path/to/project
# Path berikut relatif terhadap base_dir:
NUSAKLIM_DAILY_CSV_PATH=nusaklim_daily_aggregated.csv
NUSAKLIM_RAW_DATA_DIR=data_raw
NUSAKLIM_LOG_DIR=logs
NUSAKLIM_MODEL_BUNDLE_PATH=models/weather_model_latest.joblib
NUSAKLIM_OPENMETEO_SUMMARY_PATH=openmeteo_benchmark_summary.json

# Path berikut relatif terhadap raw_data_dir:
NUSAKLIM_RAW_CSV_PATH=nusaklim-aws-reduce.csv
NUSAKLIM_INCOMING_DIR=incoming
NUSAKLIM_ARCHIVE_DIR=archive
NUSAKLIM_REJECTED_DIR=rejected
NUSAKLIM_UPLOAD_STAGING_DIR=staging
